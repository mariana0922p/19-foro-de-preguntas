# Variables públicas de Firebase (SDK web)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Variables privadas de servidor (Firebase Admin SDK - NUNCA en NEXT_PUBLIC_ ni en Git)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Conserva los \n internos de la clave y escríbela entre comillas.
FIREBASE_PRIVATE_KEY=""

# Opcional: si faltan las variables del Admin SDK, la app arranca en modo
# demostración con datos en memoria y cabeceras x-demo-*.
